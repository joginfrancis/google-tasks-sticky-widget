{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sticky Widget",
  "version": "0.1.2",
  "identifier": "in.startupmission.stickywidget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sticky Widget",
        "width": 340,
        "height": 480,
        "minWidth": 260,
        "minHeight": 200,
        "maxWidth": 620,
        "maxHeight": 1400,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Jogin Francis",
    "copyright": "Copyright \u00a9 2026 Jogin Francis",
    "shortDescription": "Google Tasks as sticky notes",
    "longDescription": "Your Google Tasks lists as sticky notes on the Windows desktop, synced both ways with Google.",
    "licenseFile": "../LICENSE"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRDMEIyODhFM0RCOENFRTMKUldUanpyZzlqaWdMVERjdWpuOTBpM2VlU0hHK2NYT3RBYjE2K3VkMFF4cEN1MW54SXA2cVgrVlkK",
      "endpoints": [
        "https://github.com/joginfrancis/google-tasks-sticky-widget/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}